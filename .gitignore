node_modules/
.cache/
dist/
data/raw/html/

# קליפים — נוצרים מהמאגר ומשקלם מגבטים. tools/clip*.mjs מייצר מחדש.
*.mp4
*.webm

# חריג: הווידאו מ-Flow אינו פלט של הצינור אלא **מקור**. אי אפשר
# לייצר אותו מחדש מהקוד — הוא נוצר פעם אחת מפריים 1986 ומפרומפט,
# ו-clip-80s.mjs נופל בלעדיו. לכן הוא נשמר למרות משקלו.
!tools/assets/80s/video/*.mp4

# עותק האפליקציה — נוצר ב-tools/app-prepare.mjs
app-dist/

# חתימת האפליקציה — לעולם לא במאגר.
# keystore הוא אישור חתימה: מי שמחזיק בו יכול לפרסם עדכונים בשם
# האפליקציה, ואיבוד שלו אומר שאי אפשר לעדכן אותה לנצח. הוא נשמר
# כסוד ב-GitHub Actions (KEYSTORE_BASE64), לא כקובץ.
*.keystore
*.jks
*.b64
keystore.properties

# חבילת האפליקציה — נבנית ב-CI ומורדת כפריט מידע. 9MB בינארי,
# ואינה מקור אמת: היא נגזרת מ-dist/ ומהמפתח שמחוץ למאגר.
*.aab
*.apk
