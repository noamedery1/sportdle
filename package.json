{
  "name": "sportdel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ספורטדל — חידת שחקן יומית לחמישה מועדוני כדורגל ישראליים",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "scrape": "node scripts/scrape.mjs",
    "enrich": "node scripts/enrich.mjs",
    "build": "node scripts/build.mjs",
    "all": "npm run scrape && npm run enrich && npm run build",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "playwright": "^1.49.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
