  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid club-colour action (Beitar shown).",
      "html": "<button class=\"ds-btn-primary\">שחקו שוב</button>",
      "css": ".ds-btn-primary{background:#FFC72C;color:#121214;border:0;border-radius:12px;min-height:50px;padding:0 24px;font:800 17px Heebo,system-ui,sans-serif;box-shadow:inset 0 -3px 0 rgba(0,0,0,.18);cursor:pointer}.ds-btn-primary:hover{filter:brightness(1.05)}.ds-btn-primary:focus-visible{outline:2.5px solid #17181C;outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White, solid-bordered control.",
      "html": "<button class=\"ds-btn-sec\">רמז</button>",
      "css": ".ds-btn-sec{background:#FFFFFF;color:#17181C;border:1.5px solid #77736B;border-radius:12px;min-height:44px;padding:10px 18px;font:700 15px Heebo,system-ui,sans-serif;box-shadow:0 1px 2px rgba(23,24,28,.08);cursor:pointer}.ds-btn-sec:hover{background:#F1EFEA;border-color:#17181C;box-shadow:none}.ds-btn-sec:focus-visible{outline:2.5px solid #17181C;outline-offset:3px}"
    },
    {
      "name": "Guess Input",
      "kind": "input",
      "refersTo": "input-guess",
      "description": "The obvious input.",
      "html": "<input class=\"ds-input\" dir=\"rtl\" placeholder=\"הקלידו שם של שחקן…\">",
      "css": ".ds-input{background:#FFFFFF;color:#17181C;border:2px solid #77736B;border-radius:12px;min-height:56px;padding:14px 16px;font:600 18px Heebo,system-ui,sans-serif;width:100%}.ds-input::placeholder{color:#5D6068;font-weight:500;opacity:1}.ds-input:focus{border-color:#17181C;box-shadow:0 0 0 3px rgba(23,24,28,.14);outline:0}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "nav",
      "refersTo": "segmented-tabs",
      "description": "Daily / friends tabs.",
      "html": "<div class=\"ds-tabs\" dir=\"rtl\"><button class=\"on\">חידה יומית</button><button>קרב חברים</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;background:#DEDBD4;border:1px solid #CFCBC2;border-radius:14px;padding:4px;max-width:340px}.ds-tabs button{flex:1;border:0;border-radius:10px;background:none;color:#454850;min-height:44px;font:700 15px Heebo,system-ui,sans-serif;cursor:pointer}.ds-tabs button.on{background:#FFC72C;color:#121214;font-weight:800;box-shadow:0 1px 3px rgba(23,24,28,.2)}.ds-tabs button:not(.on):hover{background:rgba(255,255,255,.7);color:#17181C}.ds-tabs button:focus-visible{outline:2.5px solid #17181C;outline-offset:3px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill link on content pages; duel club pick.",
      "html": "<a class=\"ds-chip\" href=\"#\">בית\"ר ירושלים</a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;min-height:44px;padding:8px 16px;background:#FFFFFF;color:#17181C;border:1.5px solid #77736B;border-radius:22px;font:700 15px Heebo,system-ui,sans-serif;text-decoration:none}.ds-chip:hover{background:#F1EFEA;border-color:#17181C}.ds-chip:focus-visible{outline:2.5px solid #17181C;outline-offset:3px}"
    },
    {
      "name": "Club Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Content-page card with club strip on the inline-start edge.",
      "html": "<a class=\"ds-card\" dir=\"rtl\" href=\"#\"><div class=\"n\">חידה #12</div><div class=\"t\">אורי מלמיליאן</div></a>",
      "css": ".ds-card{display:block;background:linear-gradient(#FFC72C,#FFC72C) right/6px 100% no-repeat,#FFFFFF;border:1px solid #D4D0C8;border-radius:12px;padding:14px 24px 15px 18px;color:#17181C;text-decoration:none;font-family:Heebo,system-ui,sans-serif;box-shadow:0 1px 2px rgba(23,24,28,.05)}.ds-card:hover{border-color:#17181C}.ds-card:focus-visible{outline:2.5px solid #17181C;outline-offset:3px}.ds-card .n{font-size:13.5px;color:#454850}.ds-card .t{font-size:18px;font-weight:800}"
    },
    {
      "name": "Guess Stripe",
      "kind": "custom",
      "refersTo": "clue-tile-exact",
      "description": "Signature: brand band with name over second band with five clue tiles (exact / close / far), patch reveal.",
      "html": "<div class=\"ds-row\" dir=\"rtl\"><div class=\"who\">אורי מלמיליאן</div><div class=\"tiles\"><div class=\"tile near\"><span class=\"k\">עמדה</span>קישור</div><div class=\"tile hit\"><span class=\"k\">לאום</span>ישראל</div><div class=\"tile\"><span class=\"k\">עונה 1</span>↑ 73/74</div><div class=\"tile\"><span class=\"k\">תארים</span>↓ 6</div><div class=\"tile\"><span class=\"k\">נולד</span>↑ 1957</div></div></div>",
      "css": ".ds-row{font-family:Heebo,system-ui,sans-serif;animation:ds-drop .45s cubic-bezier(.2,.9,.25,1.15) both}.ds-row .who{background:#FFC72C;color:#121214;padding:14px 16px 12px;font-size:26px;font-weight:900;line-height:1.1;letter-spacing:-.01em}.ds-row .tiles{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;padding:30px 14px 18px;background:#26272D}.ds-row .tile{position:relative;display:flex;align-items:center;justify-content:center;min-height:58px;border-radius:8px;background:#454750;color:#fff;font-weight:900;font-size:17px;outline:1px solid rgba(0,0,0,.12);outline-offset:-1px;animation:ds-patch .9s cubic-bezier(.3,.7,.25,1) both}.ds-row .tile.hit{background:#FFC72C;color:#121214}.ds-row .tile.near{background:#8A6A1C;color:#fff}.ds-row .k{position:absolute;top:-23px;inset-inline:0;text-align:center;font-size:13px;font-weight:600;color:#fff}@keyframes ds-drop{from{opacity:0;transform:translateY(-22px)}}@keyframes ds-patch{0%,30%{opacity:0;transform:translateY(-26px) rotate(-7deg) scale(1.15)}62%{opacity:1;transform:translateY(3px) rotate(1.5deg) scale(.97)}80%{transform:translateY(-1px) scale(1.01)}100%{opacity:1;transform:none}}@media (prefers-reduced-motion:reduce){.ds-row,.ds-row .tile{animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Supporter's Scarf on a Clean Counter",
    "overview": "Each club's game is that club's knitted supporter scarf, laid out on a light stone ground. The scarf shows up in three places only: the header wordmark band with its fringe, the guess stripes, and the club picker, plus the small mini-scarf on the result card. Everything around it is plain and solid: white surfaces, ink text, controls with solid borders that look like controls. The knit carries the identity. The chrome doesn't compete with it.\n\nThe system is per-club. One set of rules is retinted at runtime from `config/clubs.json` through `applyTheme` (game) and `themeStyle` (content pages). Brand colour, second colour and \"near\" colour are all club data. Contrast-picked ink (dark-on-colour or white) is computed from luminance, never hand-assigned per club, so a club that changes its colours does not break anything.\n\nThe direction was first built as a dark navy knitted ground with sewn fabric labels and dashed stitch outlines. The owner rejected that twice and steered to the current light, smooth ground. None of the fabric-label language survives in the rendered result.",
    "keyCharacteristics": [
      "A light stone ground (never dark), with solid white surfaces and solid ink text.",
      "Club colour appears as knitted wool only in scarf bands. Everywhere else it is a flat fill.",
      "Controls are solid and bordered, at least 44px tall, and clearly controls.",
      "Clue tiles are flat, high-contrast swatches: exact, close, far.",
      "Guess reveal (\"patches\"): tiles drop onto the stripe like patches pressed onto a scarf."
    ],
    "rules": [
      {
        "name": "The Three Signals Rule",
        "body": "Exact is the club's full brand colour. Close is the club's own config near colour with white text. Far is Miss Slate gray. There is no fourth state, and no ring, outline or white variant of \"close\".",
        "section": "colors"
      },
      {
        "name": "The Club Colours Are Data Rule",
        "body": "Club names and club colours come from `config/clubs.json` and are binding. Never hard-code a club colour in a component. Never pick on-colour ink per club: compute it from contrast.",
        "section": "colors"
      },
      {
        "name": "The Stone, Never Night Rule",
        "body": "The ground is Stone Ground. A dark or navy page ground is rejected.",
        "section": "colors"
      },
      {
        "name": "The Solid Ink Wordmark Rule",
        "body": "The club name in the header is set in solid ink (`--title-ink`: the club's second colour when that reaches 3:1 on brand, otherwise the contrast-picked ink). The knit texture is never clipped into the letters.",
        "section": "typography"
      },
      {
        "name": "The Knit Is Diluted Rule",
        "body": "Wherever the knit texture shows, a brand-colour wash at `--knit-mute` (0.68) sits over the multiplied knit, so the wool is felt rather than seen and text on it stays crisp.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the page ground at Stone Ground (#ECEAE5) on every surface, game and content alike.",
